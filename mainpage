<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>北海道玩雪遊 注音版</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Huninn&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#FFFCF6; --ink:#3E3A39;
  --coral:#F2A497; --yellow:#F6D27A; --sky:#A8D3E6; --green:#B9DAA5;
  --bw:3px; --r:24px;
  --nav-h:58px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-padding-top:calc(var(--nav-h) + 12px)}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
body{
  background:var(--paper);color:var(--ink);
  font-family:"Huninn","Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;
  font-size:16px;line-height:1.6;
  padding-top:calc(var(--nav-h) + env(safe-area-inset-top));
  -webkit-text-size-adjust:100%;
}
a{color:inherit}
.wrap{max-width:560px;margin:0 auto;padding:0 16px}
section{padding:28px 0 8px}
h2.sec{
  display:flex;align-items:center;gap:10px;
  font-size:22px;font-weight:400;margin-bottom:16px;
}
h2.sec .dot{
  width:38px;height:38px;border:var(--bw) solid var(--ink);border-radius:50%;
  display:grid;place-items:center;font-size:18px;flex:none;
}
.card{
  background:var(--paper);border:var(--bw) solid var(--ink);border-radius:var(--r);
  box-shadow:4px 4px 0 var(--ink);
}

/* ---------- 頂端固定選單 ---------- */
header.top{
  position:fixed;top:0;left:0;right:0;z-index:50;
  background:var(--paper);border-bottom:var(--bw) solid var(--ink);
  padding-top:env(safe-area-inset-top);
}
header.top .in{
  max-width:560px;margin:0 auto;height:var(--nav-h);
  display:flex;align-items:center;gap:6px;padding:0 10px;
}
.brand{display:none;font-size:15px;white-space:nowrap;margin-right:4px}
@media (min-width:480px){.brand{display:block}}
nav{display:flex;gap:6px;flex:1;justify-content:space-between}
nav a{
  flex:1;text-decoration:none;text-align:center;font-size:14px;line-height:1;
  padding:9px 2px;border:var(--bw) solid var(--ink);border-radius:999px;
  background:var(--paper);transition:transform .2s;
}
nav a .ic{display:block;font-size:15px;margin-bottom:2px}
nav a.on{background:var(--yellow);animation:bounce .5s}
nav a:nth-child(1).on{background:var(--coral)}
nav a:nth-child(2).on{background:var(--sky)}
nav a:nth-child(3).on{background:var(--yellow)}
nav a:nth-child(4).on{background:var(--green)}
nav a:nth-child(5).on{background:var(--coral)}

/* ---------- 首頁 ---------- */
.hero{overflow:hidden;margin-top:18px}
.hero svg{display:block;width:100%;height:auto;border-bottom:var(--bw) solid var(--ink)}
.hero .txt{padding:18px 18px 20px;text-align:center}
.hero .kicker{
  display:inline-block;background:var(--yellow);border:var(--bw) solid var(--ink);
  border-radius:999px;padding:2px 14px;font-size:14px;margin-bottom:10px;
}
.hero h1{font-size:34px;font-weight:400;line-height:1.25;letter-spacing:2px}
.hero .date{margin-top:6px;font-size:15px}
.route{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:12px}
.route span{
  border:var(--bw) solid var(--ink);border-radius:999px;padding:0 11px;font-size:14px;
}
.route i{font-style:normal;align-self:center}
.count{
  margin-top:18px;border:var(--bw) solid var(--ink);border-radius:20px;
  background:var(--sky);padding:12px 10px 14px;
}
.count .lbl{font-size:15px;margin-bottom:8px}
.count .boxes{display:flex;justify-content:center;gap:8px}
.count .b{
  min-width:64px;background:var(--paper);border:var(--bw) solid var(--ink);
  border-radius:16px;padding:4px 6px 2px;
}
.count .b strong{display:block;font-size:30px;font-weight:400;line-height:1.15}
.count .b small{font-size:13px}
.count .done{font-size:17px;line-height:1.6;padding:4px 6px}

/* 插圖動畫 */
.sunrays{transform-box:view-box;transform-origin:300px 52px;animation:spin 40s linear infinite}
.drift1{animation:drift 9s ease-in-out infinite alternate}
.drift2{animation:drift 12s ease-in-out infinite alternate-reverse}
.fly{animation:fly 20s linear infinite}
.plane-in{animation:bob 3s ease-in-out infinite}
.train{animation:train 18s linear infinite}
.boat{transform-box:fill-box;transform-origin:50% 100%;animation:sway 4s ease-in-out infinite}
.waves{animation:drift 5s ease-in-out infinite alternate}
.leaf{transform-box:fill-box;transform-origin:center;animation:fall 9s linear infinite}
.leaf.l2{animation-delay:-3s;animation-duration:11s}
.leaf.l3{animation-delay:-6s;animation-duration:10s}
.steam{animation:steam 3s ease-in-out infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes drift{from{transform:translateX(-8px)}to{transform:translateX(18px)}}
@keyframes fly{from{transform:translateX(-120px)}to{transform:translateX(420px)}}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes train{from{transform:translateX(-330px)}to{transform:translateX(400px)}}
@keyframes sway{0%,100%{transform:rotate(-3deg) translateY(0)}50%{transform:rotate(3deg) translateY(3px)}}
@keyframes fall{
  0%{transform:translate(0,-30px) rotate(0);opacity:0}
  10%{opacity:1}
  90%{opacity:1}
  100%{transform:translate(-40px,190px) rotate(300deg);opacity:0}
}
@keyframes steam{0%,100%{transform:translateY(0);opacity:.9}50%{transform:translateY(-5px);opacity:.5}}
@keyframes bounce{
  0%{transform:scale(1)}
  35%{transform:translateY(-8px) scale(1.1)}
  65%{transform:translateY(2px) scale(.96)}
  100%{transform:none}
}
@keyframes pop{
  0%{transform:translateY(18px) scale(.92);opacity:0}
  55%{transform:translateY(-6px) scale(1.03);opacity:1}
  100%{transform:none;opacity:1}
}

/* ---------- 航班 ---------- */
.ticket{overflow:hidden;margin-bottom:18px}
.ticket .band{
  display:flex;justify-content:space-between;align-items:center;
  padding:8px 16px;border-bottom:var(--bw) solid var(--ink);font-size:15px;
}
.ticket .main{display:flex;align-items:center;gap:6px;padding:16px 14px 10px}
.ticket .pt{flex:none;text-align:center;min-width:76px}
.ticket .pt b{display:block;font-size:30px;font-weight:400;line-height:1.1;letter-spacing:1px}
.ticket .pt span{font-size:14px}
.ticket .pt em{display:block;font-style:normal;font-size:20px;margin-top:2px}
.ticket .path{flex:1;position:relative;height:30px;min-width:40px}
.ticket .path::before{
  content:"";position:absolute;left:0;right:0;top:50%;border-top:var(--bw) dashed var(--ink);
}
.ticket .path svg{position:absolute;left:50%;top:50%;width:34px;height:34px;transform:translate(-50%,-50%)}
.ticket .foot{
  border-top:var(--bw) dashed var(--ink);margin:6px 14px 0;padding:10px 0 14px;
  font-size:14px;display:flex;flex-wrap:wrap;gap:6px 14px;
}
.ticket .foot b{font-weight:400;background:var(--yellow);border-radius:8px;padding:0 6px}
.carcard{padding:14px 16px;background:var(--green)}
.carcard h3{font-size:18px;font-weight:400;margin-bottom:4px}
.carcard p{font-size:15px}

/* ---------- 每日行程 ---------- */
.days{
  position:sticky;top:calc(var(--nav-h) + env(safe-area-inset-top));z-index:20;
  background:var(--paper);margin:0 -16px;padding:10px 16px 12px;
  border-bottom:var(--bw) solid var(--ink);
}
.days .row{position:relative;display:flex;gap:8px;overflow-x:auto;padding:4px 4px 8px;scrollbar-width:none}
.days .row::-webkit-scrollbar{display:none}
.chip{
  flex:none;width:62px;text-align:center;font:inherit;color:inherit;cursor:pointer;
  background:var(--paper);border:var(--bw) solid var(--ink);border-radius:18px;
  padding:5px 0 6px;line-height:1.2;
}
.chip b{display:block;font-size:12px;font-weight:400}
.chip strong{display:block;font-size:18px;font-weight:400}
.chip small{display:block;font-size:12px}
.chip.on{box-shadow:3px 3px 0 var(--ink)}
.chip.bounce{animation:bounce .55s}
.dayhead{margin-top:18px;padding:14px;display:flex;gap:14px;align-items:center}
.dayhead .mo{flex:none;width:68px;height:68px}
.dayhead .mo svg{width:100%;height:100%;display:block}
.dayhead small{font-size:13px}
.dayhead h3{font-size:22px;font-weight:400;line-height:1.3}
.dayhead .hot{margin-top:4px;font-size:14px;line-height:1.45}
.tl{position:relative;margin-top:22px;padding-bottom:6px}
.tl::before{
  content:"";position:absolute;top:8px;bottom:8px;left:75px;
  border-left:var(--bw) dashed var(--ink);
}
.it{display:flex;gap:10px;margin-bottom:14px;position:relative;animation:pop .55s both}
.it .tm{
  flex:none;width:48px;text-align:right;font-size:13px;line-height:36px;
  white-space:nowrap;
}
.it .nd{
  flex:none;width:36px;height:36px;border-radius:50%;border:var(--bw) solid var(--ink);
  display:grid;place-items:center;font-size:16px;background:var(--paper);position:relative;z-index:1;
}
.it .bd{
  flex:1;min-width:0;border:var(--bw) solid var(--ink);border-radius:18px;
  background:var(--paper);padding:8px 12px 10px;position:relative;
}
.it .bd h4{font-size:16px;font-weight:400;line-height:1.45;word-break:break-word}
.it .bd p{font-size:14px;line-height:1.55;margin-top:2px;white-space:pre-line;word-break:break-word}
.must{
  position:absolute;top:-13px;right:10px;transform:rotate(4deg);
  background:var(--coral);border:var(--bw) solid var(--ink);border-radius:999px;
  padding:0 10px;font-size:13px;line-height:21px;z-index:2;
}
.it.mustit .bd{box-shadow:3px 3px 0 var(--coral);}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.tag{
  border:2.5px solid var(--ink);border-radius:999px;padding:0 9px;
  font-size:12.5px;line-height:20px;white-space:nowrap;
}
.lk{
  text-decoration:none;border:2.5px solid var(--ink);border-radius:999px;padding:0 9px;
  font-size:12.5px;line-height:20px;background:var(--paper);
}
.lk:active{background:var(--yellow)}
.k-sight .nd{background:var(--green)}
.k-food .nd{background:var(--yellow)}
.k-move .nd{background:var(--sky)}
.k-stay .nd{background:var(--coral)}
.k-task .nd{background:var(--paper)}

/* ---------- 待辦 ---------- */
.prog{padding:14px 16px;margin-bottom:16px}
.prog .t{display:flex;justify-content:space-between;font-size:15px;margin-bottom:8px}
.bar{height:20px;border:var(--bw) solid var(--ink);border-radius:999px;overflow:hidden;background:var(--paper)}
.bar i{display:block;height:100%;width:0;background:var(--coral);border-right:var(--bw) solid var(--ink);transition:width .4s cubic-bezier(.3,1.6,.5,1)}
.bar i.zero{border-right:0}
.grp{margin-bottom:16px;overflow:hidden}
.grp h3{
  font-size:17px;font-weight:400;padding:7px 16px;border-bottom:var(--bw) solid var(--ink);
  display:flex;justify-content:space-between;
}
.grp ul{list-style:none;padding:8px 10px 10px}
.todo{display:flex;align-items:center;gap:12px;padding:7px 6px;cursor:pointer;font-size:16px;min-height:44px}
.todo input{position:absolute;opacity:0;pointer-events:none}
.todo .bx{
  flex:none;width:28px;height:28px;border:var(--bw) solid var(--ink);border-radius:9px;
  background:var(--paper);display:grid;place-items:center;
}
.todo .bx svg{width:18px;height:18px;opacity:0;transform:scale(.3)}
.todo input:checked + .bx{background:var(--green);animation:bounce .45s}
.todo input:checked + .bx svg{opacity:1;transform:none;transition:transform .25s}
.todo input:checked ~ .nm{text-decoration:line-through;text-decoration-thickness:2px;opacity:.55}
.todo input:focus-visible + .bx{outline:3px solid var(--sky);outline-offset:2px}

/* ---------- 住宿 ---------- */
.stay{margin-bottom:16px;overflow:hidden}
.stay .hd{
  display:flex;justify-content:space-between;align-items:center;gap:8px;
  padding:8px 14px;border-bottom:var(--bw) solid var(--ink);font-size:14px;
}
.stay .hd b{font-weight:400;background:var(--paper);border:2.5px solid var(--ink);border-radius:999px;padding:0 10px}
.stay .bd{padding:12px 14px 14px;display:flex;gap:12px;align-items:flex-start}
.stay .bd svg{flex:none;width:52px;height:52px}
.stay h3{font-size:18px;font-weight:400;line-height:1.4}
.stay .meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.stay .meta span,.stay .meta a{
  border:2.5px solid var(--ink);border-radius:999px;padding:0 10px;font-size:13px;line-height:21px;text-decoration:none;
}

footer{text-align:center;font-size:13px;padding:30px 16px calc(36px + env(safe-area-inset-bottom))}
footer svg{width:90px;height:auto;display:block;margin:0 auto 8px}

/* 雪景動畫 */
.flake{animation:snow 9s linear infinite}
.gond{animation:gond 10s ease-in-out infinite alternate}
.waddle{transform-box:fill-box;transform-origin:50% 100%;animation:waddle 2.6s ease-in-out infinite}
@keyframes snow{0%{transform:translate(0,-30px);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translate(-36px,250px);opacity:0}}
@keyframes gond{from{transform:translate(0,0)}to{transform:translate(92px,-74px)}}
@keyframes waddle{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}

/* ---------- 直排注音版 ---------- */
:root{--nav-h:66px}
body{font-size:18px;line-height:1.75}
.zc{display:inline-block;white-space:nowrap}
.zh{display:inline}
.zz{display:inline-flex;align-items:center;position:relative;vertical-align:middle;
  margin:0 .14em 0 .05em;font-size:max(10px,.62em);line-height:1;font-weight:400;font-style:normal;
  font-family:"Huninn","Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif}
.zy{display:flex;flex-direction:column;align-items:center}
.zy z-s,.zz z-s{display:block;font-style:normal}
.zy z-s{line-height:.93;width:1em;text-align:center}
.zt{margin-left:.02em;font-size:1.1em;line-height:1;width:.45em;text-align:center}
.zn{position:absolute;top:-.85em;left:0;right:0;text-align:center;line-height:1;font-size:1.1em}
nav a{font-size:12.5px;line-height:1.2;padding:6px 0 7px}
nav a .ic{margin-bottom:0}
h2.sec{font-size:26px}
.hero h1{font-size:38px;line-height:1.5}
.hero .date,.hero .kicker,.route span{font-size:16px}
.ticket .band{font-size:16px}
.ticket .foot,.carcard p{font-size:16px}
.carcard h3{font-size:20px}
.dayhead h3{font-size:25px;line-height:1.6}
.dayhead .hot{font-size:16px}
.dayhead small{font-size:14px}
.chip{width:68px}
.chip b,.chip small{font-size:13px}
.it .tm{width:64px;font-size:14px;line-height:1.35;padding-top:5px;white-space:normal}
.tl::before{left:93px}
.it .bd h4{font-size:21px;line-height:1.85}
.it .bd p{font-size:17px;line-height:1.95}
.tag,.lk{font-size:14px;line-height:1.55;padding:1px 10px}
.must{font-size:15px;line-height:1.5}
.todo{font-size:19px}
.grp h3{font-size:19px}
.prog .t{font-size:17px}
.stay h3{font-size:21px;line-height:1.75}
.stay .hd,.stay .meta span,.stay .meta a,.stay .hd b{font-size:15px}
footer{font-size:15px}
.count .lbl{font-size:17px}
.count .b small{font-size:15px}
/* ---------- 減少動態效果 ---------- */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation:none !important;transition:none !important;scroll-behavior:auto !important;
  }
  .it{opacity:1}
}
</style>

<noscript id="nojs"><style>.days,.prog,.count{display:none !important}.it{animation:none !important}</style></noscript>
</head>
<body>

<header class="top">
  <div class="in">
    <div class="brand">⛄ <z-c class="zc"><z-h class="zh">北</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄅ</z-s><z-s>ㄟ</z-s></z-y><z-s class="zt">ˇ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">海</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄏ</z-s><z-s>ㄞ</z-s></z-y><z-s class="zt">ˇ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">道</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄉ</z-s><z-s>ㄠ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c></div>
    <nav id="nav" aria-label="主選單">
      <a href="#home" class="on"><span class="ic">🏠</span><z-c class="zc"><z-h class="zh">首</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄕ</z-s><z-s>ㄡ</z-s></z-y><z-s class="zt">ˇ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">頁</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄧ</z-s><z-s>ㄝ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c></a>
      <a href="#flight"><span class="ic">✈️</span><z-c class="zc"><z-h class="zh">航</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄏ</z-s><z-s>ㄤ</z-s></z-y><z-s class="zt">ˊ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">班</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄅ</z-s><z-s>ㄢ</z-s></z-y></z-z></z-c></a>
      <a href="#plan"><span class="ic">🗓️</span><z-c class="zc"><z-h class="zh">行</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄒ</z-s><z-s>ㄧ</z-s><z-s>ㄥ</z-s></z-y><z-s class="zt">ˊ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">程</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄔ</z-s><z-s>ㄥ</z-s></z-y><z-s class="zt">ˊ</z-s></z-z></z-c></a>
      <a href="#todo"><span class="ic">✅</span><z-c class="zc"><z-h class="zh">待</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄉ</z-s><z-s>ㄞ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">辦</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄅ</z-s><z-s>ㄢ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c></a>
      <a href="#stay"><span class="ic">🛏️</span><z-c class="zc"><z-h class="zh">住</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄓ</z-s><z-s>ㄨ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">宿</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄙ</z-s><z-s>ㄨ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c></a>
    </nav>
  </div>
</header>

<main class="wrap">

<!-- ====== 首頁 ====== -->
<section id="home" style="padding-top:4px">
  <div class="card hero">
    <svg viewBox="0 0 360 250" role="img" aria-label="北海道雪景插畫：雪山與纜車、雪人、企鵝、小木屋、飛機與飄雪">
      <defs>
        <g id="pine" stroke="#3E3A39" stroke-width="3" stroke-linejoin="round">
          <rect x="-3" y="-8" width="6" height="10" fill="#3E3A39"/>
          <path d="M0 -50 L16 -26 L-16 -26 Z" fill="#B9DAA5"/>
          <path d="M0 -36 L20 -8 L-20 -8 Z" fill="#B9DAA5"/>
          <path d="M0 -50 L6.5 -40 L-6.5 -40 Z" fill="#FFFCF6" stroke-width="2"/>
          <path d="M0 -36 L8 -25 L-8 -25 Z" fill="#FFFCF6" stroke-width="2"/>
        </g>
      </defs>
      <rect width="360" height="250" fill="#A8D3E6"/>
      <!-- 太陽 -->
      <g class="sunrays" stroke="#3E3A39" stroke-width="3" stroke-linecap="round">
        <line x1="326" y1="52" x2="334" y2="52"/><line x1="318.4" y1="70.4" x2="324" y2="76"/>
        <line x1="300" y1="78" x2="300" y2="86"/><line x1="281.6" y1="70.4" x2="276" y2="76"/>
        <line x1="274" y1="52" x2="266" y2="52"/><line x1="281.6" y1="33.6" x2="276" y2="28"/>
