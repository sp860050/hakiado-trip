const $=s=>document.querySelector(s);
const RM = window.matchMedia('(prefers-reduced-motion: reduce)');
const chipsEl=$('#chips'), tlEl=$('#tl'), headEl=$('#dayhead');
let cur=-1;

DAYS.forEach((day,i)=>{
  const b=document.createElement('button');
  b.className='chip'; b.type='button'; b.setAttribute('role','tab');
  b.innerHTML=`<b>DAY ${i+1}</b><strong>${day.d.slice(3)}</strong><small>${day.w}</small>`;
  b.style.background='var(--paper)';
  b.addEventListener('click',()=>selectDay(i,true));
  chipsEl.appendChild(b);
});

function selectDay(i,fromClick){
  if(i===cur&&fromClick){ /* <z-c class="zc"><z-h class="zh">再</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄗ</z-s><z-s>ㄞ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">按</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄢ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">一</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄧ</z-s></z-y></z-z></z-c><z-c class="zc"><z-h class="zh">次</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄘ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">也</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄧ</z-s><z-s>ㄝ</z-s></z-y><z-s class="zt">ˇ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">彈</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄉ</z-s><z-s>ㄢ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">一</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄧ</z-s></z-y></z-z></z-c><z-c class="zc"><z-h class="zh">下</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄒ</z-s><z-s>ㄧ</z-s><z-s>ㄚ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c> */ }
  cur=i;
  const day=DAYS[i];
  [...chipsEl.children].forEach((c,j)=>{
    const on=j===i;
    c.classList.toggle('on',on);
    c.setAttribute('aria-selected',on);
    c.style.background=on?day.c:'var(--paper)';
    c.classList.remove('bounce');
    if(on){void c.offsetWidth;c.classList.add('bounce')}
  });
  const chip=chipsEl.children[i];
  chipsEl.scrollTo({left:chip.offsetLeft-(chipsEl.clientWidth-chip.offsetWidth)/2,behavior:(RM.matches||!fromClick)?'auto':'smooth'});

  headEl.innerHTML=`<div class="card dayhead" style="background:${day.c}">
    <div class="mo">${MOTIF[day.mo]}</div>
    <div><small>DAY ${i+1} · ${day.d} (${day.w})</small>
    <h3>${day.route}</h3>
    <div class="hot">${i===DAYS.length-1?'🏠':'🛏'} ${i===DAYS.length-1?day.hotel:'<z-c class="zc"><z-h class="zh">今</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄐ</z-s><z-s>ㄧ</z-s><z-s>ㄣ</z-s></z-y></z-z></z-c><z-c class="zc"><z-h class="zh">晚</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄨ</z-s><z-s>ㄢ</z-s></z-y><z-s class="zt">ˇ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">住</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄓ</z-s><z-s>ㄨ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c> · '+day.hotel}</div></div></div>`;

  tlEl.innerHTML=day.items.map((it,n)=>{
    const tags=it.m.map(k=>`<span class="tag" style="background:${MODES[k].c}">${MODES[k].t}</span>`).join('');
    const links=it.links.map(l=>`<a class="lk" href="${l[1]}" target="_blank" rel="noopener">${l[0]} ↗</a>`).join('');
    const extra=(tags||links)?`<div class="tags">${tags}${links}</div>`:'';
    return `<div class="it k-${it.k}${it.must?' mustit':''}" style="animation-delay:${n*60}ms">
      <div class="tm">${it.tm}</div>
      <div class="nd" aria-hidden="true">${KIND[it.k]}</div>
      <div class="bd">${it.must?'<span class="must">★ <z-c class="zc"><z-h class="zh">必</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄅ</z-s><z-s>ㄧ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c><z-c class="zc"><z-h class="zh">去</z-h><z-z class="zz"><z-y class="zy"><z-s>ㄑ</z-s><z-s>ㄩ</z-s></z-y><z-s class="zt">ˋ</z-s></z-z></z-c></span>':''}
        <h4>${it.title}</h4>${it.desc?`<p>${it.desc}</p>`:''}${extra}</div></div>`;
  }).join('');
}

