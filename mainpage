const gEl=$('#groups');
let total=0;
TODOS.forEach((g,gi)=>{
  const lis=g.items.map((x,i)=>{
    const name=Array.isArray(x)?x[0]:x, def=Array.isArray(x)?x[1]:0, id=`${gi}-${i}`;
    total++;
    const on=(id in saved)?saved[id]:!!def;
    return `<li><label class="todo"><input type="checkbox" data-id="${id}" data-g="${gi}"${on?' checked':''}>
      <span class="bx">${BOX}</span><span class="nm">${name}</span></label></li>`;
  }).join('');
  gEl.insertAdjacentHTML('beforeend',`<div class="card grp"><h3 style="background:${g.c}"><span>${g.g}</span><span class="gc" id="gc${gi}"></span></h3><ul>${lis}</ul></div>`);
});
function updateProgress(){
  const all=[...gEl.querySelectorAll('input')];
  const done=all.filter(i=>i.checked).length;
  $('#ptxt').textContent=`${done} / ${all.length}`;
  const bar=$('#pbar'); bar.style.width=(all.length?done/all.length*100:0)+'%';
  bar.classList.toggle('zero',done===0);
  TODOS.forEach((g,gi)=>{
    const ins=all.filter(i=>i.dataset.g==gi);
    $('#gc'+gi).textContent=`${ins.filter(i=>i.checked).length}/${ins.length}`;
  });
}
gEl.addEventListener('change',e=>{
  const i=e.target; if(!i.dataset.id)return;
  saved[i.dataset.id]=i.checked;
  try{localStorage.setItem('hk-snow-todo-v1',JSON.stringify(saved))}catch(err){}
  updateProgress();
});
updateProgress();

