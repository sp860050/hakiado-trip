const links=[...document.querySelectorAll('#nav a')];
const secs=links.map(a=>document.querySelector(a.getAttribute('href')));
let spyT;
function spy(){
  const y=window.scrollY+120;
  let idx=0; secs.forEach((s,i)=>{if(s.offsetTop<=y)idx=i});
  if(window.innerHeight+window.scrollY>=document.body.scrollHeight-4)idx=secs.length-1;
  links.forEach((a,i)=>{
    const on=i===idx;
    if(on&&!a.classList.contains('on')){a.classList.remove('on');void a.offsetWidth}
    a.classList.toggle('on',on);
  });
}
window.addEventListener('scroll',()=>{clearTimeout(spyT);spyT=setTimeout(spy,40)},{passive:true});
spy();
